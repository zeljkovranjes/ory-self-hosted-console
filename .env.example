# =============================================================================
# .env.example — Ory Self-Hosted Console bootstrap contract (INFRA-06)
# =============================================================================
# Copy this file to `.env` and fill in the values, then run `docker compose up`.
#   cp .env.example .env
#
# `.env` is gitignored — NEVER commit real secrets. The values below are
# placeholders only.
#
# All internal service URLs, DB wiring, and per-service config are generated /
# bootstrapped automatically from the values here — you do NOT hand-edit any
# internal hostnames or ports.
# =============================================================================

# -----------------------------------------------------------------------------
# THE ONLY THINGS YOU MUST SET  (operator-facing bootstrap inputs — INFRA-06)
# -----------------------------------------------------------------------------
# A single Ory API base URL the console/backend targets, plus the local admin
# credential you will use to sign in to the console. Mirrors the Ory Network
# experience: point at one base URL + supply one admin credential.

# Single Ory API base URL (the backend's entry point into the Ory stack).
# Default points at the internal Oathkeeper proxy; override only if you front
# the stack with your own gateway.
ORY_BASE_URL=http://oathkeeper:4455

# Local console admin credential (used by the Phase 2 /setup login).
# ADMIN_PASSWORD is the HIGHEST-VALUE secret in this contract. The value below is
# an obviously-invalid SENTINEL, not a plausible password, so it cannot be shipped
# to production unchanged by accident (WR-07). Phase 2's /setup must reject this
# sentinel and enforce a minimum password strength.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__REPLACE_ME__

# -----------------------------------------------------------------------------
# Supporting secrets / credentials the compose file interpolates
# (sensible dev defaults are fine for a local infra bring-up; production MUST
#  set strong, unique values).
# -----------------------------------------------------------------------------

# Postgres super-user (owns the cluster; per-DB roles are created by db/init).
POSTGRES_USER=ory
POSTGRES_PASSWORD=change_me_postgres_superuser

# Per-service database role passwords. These MUST match the role passwords the
# db/init/01-init.sql script sets on the FIRST (fresh-volume) boot. Change all
# of them together (init SQL + here) before first boot for production.
KRATOS_DB_PASSWORD=changeme_kratos
HYDRA_DB_PASSWORD=changeme_hydra
KETO_DB_PASSWORD=changeme_keto
CONSOLE_DB_PASSWORD=changeme_console

# Hydra system secret — encrypts OAuth2 data at rest.
# !! IMMUTABLE AFTER FIRST MIGRATION !!  Per Ory docs this value "must remain
# consistent across restarts and cannot be rotated"; changing it after Hydra
# initializes its DB breaks decryption of all stored data. Set a strong, STABLE
# random value once (>= 16 chars) and never change it.
HYDRA_SECRETS_SYSTEM=change_me_stable_hydra_system_secret

# Kratos cookie + cipher secrets are currently sourced from config/kratos/kratos.yml
# placeholders; production should override them via env injection (Phase 2). The
# cipher secret MUST be exactly 32 characters; cookie >= 32 characters.

# -----------------------------------------------------------------------------
# Ory per-service ADMIN URLs (Phase 3, BACK-02) — DO NOT normally set these.
# -----------------------------------------------------------------------------
# The backend talks to the Ory Admin APIs over the INTERNAL Docker network using
# the service-name defaults below (baked into docker-compose backend.environment).
# They are NOT secrets (no credential) and need NO operator override for the
# standard single-host compose topology. The admin ports are never published to
# the host (INFRA-05). Override ONLY if you run the Ory services elsewhere.
#   KRATOS_ADMIN_URL=http://kratos:4434
#   HYDRA_ADMIN_URL=http://hydra:4445
#   KETO_READ_URL=http://keto:4466
#   KETO_WRITE_URL=http://keto:4467
#   OATHKEEPER_API_URL=http://oathkeeper:4456

# -----------------------------------------------------------------------------
# Ory Polis (SAML bridge — Phase 13, SSO-01)
# -----------------------------------------------------------------------------
# Ory Polis (BoxyHQ Jackson) bridges SAML/OIDC IdPs into a single OAuth2/OIDC
# provider that Kratos consumes. It runs as the `polis` compose service against
# its own `polis` logical DB. Placeholders ONLY below — NEVER commit real secrets
# (BACK-07 write-only posture). Generate real values and put them in `.env`.

# Password for the least-privilege `polis` Postgres role. MUST match the role
# password db/init/01-init.sql sets on the FIRST (fresh-volume) boot.
POLIS_DB_PASSWORD=changeme_polis

# Encrypts Polis connection data at rest. Generate with: openssl rand -base64 32
# !! 32-byte base64; IMMUTABLE AFTER FIRST BOOT !! Rotating it strands every
# encrypted connection row (Pitfall 5). Set once, never change.
POLIS_DB_ENCRYPTION_KEY=

# Admin-API key(s) for the backend's `Authorization: Api-Key` calls (Phase 14
# SAML connection CRUD). Comma-separated for multiple. The backend is the SOLE
# client of the Polis admin API (it stays internal-only, INFRA-05).
POLIS_API_KEY=

# Admin-portal JWT/session secret. Generate with: openssl rand -base64 32
POLIS_NEXTAUTH_SECRET=

# OIDC id_token signing keypair (RS256), base64-encoded.
# !! PRIVATE KEY IS IMMUTABLE AFTER FIRST BOOT !! Rotating it invalidates every
# already-issued token (Pitfall 5). The public key must match the private key.
POLIS_OPENID_RSA_PRIVATE_KEY=
POLIS_OPENID_RSA_PUBLIC_KEY=

# Single public OIDC issuer URL. Polis derives EVERY discovery/OAuth endpoint
# from this one base, so it MUST be reachable IDENTICALLY by the browser AND by
# Kratos server-side (split-horizon, Pattern A). Use your public edge origin.
POLIS_EXTERNAL_URL=https://sso.example.com

# -----------------------------------------------------------------------------
# Observability profile (Phase 16, OBS-01..05) — OPT-IN, default OFF.
# -----------------------------------------------------------------------------
# Prometheus + Grafana + Loki + Grafana Alloy ship under the `observability`
# compose profile. A plain `docker compose up` does NOT start them. To enable:
#
#   cp secrets/grafana_admin_password.example secrets/grafana_admin_password
#   # edit secrets/grafana_admin_password and set a strong value
#   docker compose --profile observability up -d
#
# There is NO env toggle — the compose PROFILE is the switch, and the
# `observability` FEATURE FLAG (Phase 12) gates the console surfaces. None of the
# four services publishes a host port (internal-only, INFRA-05); Grafana is
# reachable only through the authenticated backend reverse-proxy (plan 16-02).

# -----------------------------------------------------------------------------
# Host port mappings (edge network — the only host-published services)
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Account Experience (AX) — the end-user auth UI (Phase 15, AX-01/AX-05). MUST be
# a DIFFERENT host port than FRONTEND_PORT so the AX is a SEPARATE ORIGIN from the
# admin console: the AX issues only Kratos cookies (ory_kratos_session), never the
# console's __Host-console_session. This is also the origin Kratos's rebound
# selfservice.flows.*.ui_url keys point at (config/kratos/kratos.yml).
ACCOUNT_EXPERIENCE_PORT=3001

# =============================================================================
# .env.example — Ory Self-Hosted Console bootstrap contract (INFRA-06)
# =============================================================================
# Copy this file to `.env` and fill in the values, then run `docker compose up`.
#   cp .env.example .env
#
# `.env` is gitignored — NEVER commit real secrets. The values below are
# placeholders only.
#
# All internal service URLs, DB wiring, and per-service config are generated /
# bootstrapped automatically from the values here — you do NOT hand-edit any
# internal hostnames or ports.
# =============================================================================

# -----------------------------------------------------------------------------
# THE ONLY THINGS YOU MUST SET  (operator-facing bootstrap inputs — INFRA-06)
# -----------------------------------------------------------------------------
# A single Ory API base URL the console/backend targets, plus the local admin
# credential you will use to sign in to the console. Mirrors the Ory Network
# experience: point at one base URL + supply one admin credential.

# Single Ory API base URL (the backend's entry point into the Ory stack).
# Default points at the internal Oathkeeper proxy; override only if you front
# the stack with your own gateway.
ORY_BASE_URL=http://oathkeeper:4455

# Local console admin credential (used by the Phase 2 /setup login).
# ADMIN_PASSWORD is the HIGHEST-VALUE secret in this contract. The value below is
# an obviously-invalid SENTINEL, not a plausible password, so it cannot be shipped
# to production unchanged by accident (WR-07). Phase 2's /setup must reject this
# sentinel and enforce a minimum password strength.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__REPLACE_ME__

# -----------------------------------------------------------------------------
# Supporting secrets / credentials the compose file interpolates
# (sensible dev defaults are fine for a local infra bring-up; production MUST
#  set strong, unique values).
# -----------------------------------------------------------------------------

# Postgres super-user (owns the cluster; per-DB roles are created by db/init).
POSTGRES_USER=ory
POSTGRES_PASSWORD=change_me_postgres_superuser

# Per-service database role passwords. These MUST match the role passwords the
# db/init/01-init.sql script sets on the FIRST (fresh-volume) boot. Change all
# of them together (init SQL + here) before first boot for production.
KRATOS_DB_PASSWORD=changeme_kratos
HYDRA_DB_PASSWORD=changeme_hydra
KETO_DB_PASSWORD=changeme_keto
CONSOLE_DB_PASSWORD=changeme_console

# Hydra system secret — encrypts OAuth2 data at rest.
# !! IMMUTABLE AFTER FIRST MIGRATION !!  Per Ory docs this value "must remain
# consistent across restarts and cannot be rotated"; changing it after Hydra
# initializes its DB breaks decryption of all stored data. Set a strong, STABLE
# random value once (>= 16 chars) and never change it.
HYDRA_SECRETS_SYSTEM=change_me_stable_hydra_system_secret

# Kratos cookie + cipher secrets are currently sourced from config/kratos/kratos.yml
# placeholders; production should override them via env injection (Phase 2). The
# cipher secret MUST be exactly 32 characters; cookie >= 32 characters.

# -----------------------------------------------------------------------------
# Host port mappings (edge network — the only host-published services)
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

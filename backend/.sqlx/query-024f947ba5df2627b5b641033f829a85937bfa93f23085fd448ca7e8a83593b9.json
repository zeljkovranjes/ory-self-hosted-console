  "query": "\n        SELECT id, name, kind, target, subject, events,\n               (secret <> '') AS \"secret_set!\",\n               (sasl_username IS NOT NULL AND sasl_username <> '') AS \"sasl_username_set!\",\n               tls, enabled, created_at, updated_at\n        FROM event_sinks\n        ORDER BY created_at DESC\n        ",

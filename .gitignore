# --- Secrets / local env (never commit; .env.example is the contract) ---
.env
.env.*
!.env.example

# --- Generated signing keys (never commit a real private key; CR-01) ---
# The Oathkeeper id_token JWKS is generated at first boot into a named volume,
# not committed. If an operator generates one into the config dir, keep it out
# of git; only the placeholder jwks.json.example is tracked.
/config/oathkeeper/jwks.json
!/config/oathkeeper/jwks.json.example

# --- Rust (backend) ---
/backend/target/
**/*.rs.bk

# --- Node / Next.js (frontend) ---
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/.turbo/
/frontend/next-env.d.ts
/frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Phase 1 (compose convergence) — reaffirm secrets + build artifacts ---
# .env is the operator's filled-in secrets file; only .env.example is committed.
.env
backend/target
frontend/node_modules
frontend/.next

# --- GSD planning + AI tooling meta (never committed — product code only) ---
# Kept on disk for the GSD workflow but intentionally untracked so the repo
# contains only the deliverable product, not planning/AI-assistant artifacts.
.planning/
.claude/
.agents/
.cursor/
.codex/
.github/skills/
CLAUDE.md
GEMINI.md
AGENTS.md
.mcp.json

# --- Secrets / local env (never commit; .env.example is the contract) ---
.env
.env.*
!.env.example

# --- Rust (backend) ---
/backend/target/
**/*.rs.bk

# --- Node / Next.js (frontend) ---
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/.turbo/
/frontend/next-env.d.ts
/frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Phase 1 (compose convergence) — reaffirm secrets + build artifacts ---

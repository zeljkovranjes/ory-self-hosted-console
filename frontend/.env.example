# frontend/.env.example
# -----------------------------------------------------------------------------
# Frontend (Next.js) runtime environment. Copy to `.env.local` for local
# `next dev` against a host-run backend; in the docker-compose stack these are
# set on the `frontend` service in docker-compose.yml instead.
#
# IMPORTANT (FE-05): NOTHING here is a NEXT_PUBLIC_ var. Every value below is
# read on the SERVER ONLY (at config-eval / request time) and must never be
# inlined into the client bundle. scripts/verify/bundle-egress.sh asserts that
# no internal/Ory host literal reaches the browser bundle.
# -----------------------------------------------------------------------------

# BACKEND_INTERNAL_URL — the SERVER-ONLY backend egress target.
#
# It powers two server-side mechanisms and nothing else:
#   1. the Next `rewrites()` proxy: the browser calls the same-origin `/backend/*`
#      and the Next server forwards it to `${BACKEND_INTERNAL_URL}/*`
#      (05-RESEARCH Pattern 1), so the browser never learns the backend host.
#   2. the `(console)` layout's authoritative auth guard: a server-side
#      `${BACKEND_INTERNAL_URL}/api/console/me` fetch (lib/server-api.ts,
#      05-RESEARCH Pattern 3).
#
# NEVER prefix it with NEXT_PUBLIC_ (that would inline it into client JS and
# break the FE-05 invariant).
#
#   - In docker-compose: http://backend:8080 (the backend container on the shared
#     `edge` network). This is the value set on the compose `frontend` service.
#   - For local `next dev` against a host-run backend: http://localhost:8080
#
# Defaults to http://backend:8080 in next.config.ts when unset.
BACKEND_INTERNAL_URL=http://backend:8080
